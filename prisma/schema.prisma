generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum VolunteerRole {
  GUITARIST
  PIANIST
  AUX_KEYS
  DRUMMER
  LEAD_VOCALIST
  BGVS
  BASSIST
  SOUND_TECH
  STREAM_TECH
  PROJECTION_TECH
  USHER
  GREETER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  EXPIRED
}

enum ActivityType {
  EVENT_CREATED
  EVENT_DELETED
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_DECLINED
  INVITE_CANCELED
  AUTO_INVITE_SENT
  MEMBER_REMOVED
  MEMBER_LEFT
  ROLE_CHANGED
  SMART_FILL_SKIPPED
  SMART_FILL_NO_CANDIDATES
  SMART_FILL_ALL_UNAVAILABLE
  SMART_FILL_FAILED
  SMART_SCHEDULING_ENABLED
  SMART_SCHEDULING_DISABLED
}

enum Pitch {
  C
  C_SHARP   @map("C#")
  D_FLAT    @map("Db")
  D
  D_SHARP   @map("D#")
  E_FLAT    @map("Eb")
  E
  F
  F_SHARP   @map("F#")
  G_FLAT    @map("Gb")
  G
  G_SHARP   @map("G#")
  A_FLAT    @map("Ab")
  A
  A_SHARP   @map("A#")
  B_FLAT    @map("Bb")
  B
}

enum KeyQuality {
  MAJOR
  MINOR
}



model User {
  id        String @id @default(uuid())
  clerkId   String @unique
  email     String @unique
  firstName String
  lastName  String
  phoneNumber String?
  userImageUrl String?

  memberships Membership[]
  sentInvitations Invitation[] 
  eventsCreated Event[]
  
  assignedEvents EventAssignment[] @relation("assignedUser")
  createdAssignments EventAssignment[] @relation("assignedBy")

  authoredMessages Message[] @relation("authoredMessages")

  setlistSongAssignment SetlistSongAssignment[]

  blockoutDates BlockoutDate[]

  songKeys SongKeyEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notifications Notification[]
  pushTokens PushToken[]
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  description String
  logoUrl     String?
  logoKey     String?

  // Stripe billing — mirror of entitlement feature lookup_keys from Stripe
  stripeCustomerId String?  @unique
  entitlements     String[] @default([])

  memberships Membership[]
  invitations Invitation[]
  serviceTypes ServiceType[]
  events Event[]
  eventTemplates EventTemplate[]
  eventAssignments EventAssignment[]
  songs Song[]
  messages Message[]
  blockoutDates BlockoutDate[]
  activityLogs ActivityLog[]
  songKeys SongKeyEntry[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notifications Notification[]
}

model Membership {
  id          String   @id @default(uuid())
  role OrgRole @default(MEMBER)
  volunteerRoles VolunteerRole[]

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
}

model Invitation {
  id String @id @default(uuid())
  email String 
  token String @unique @default(uuid())
  status InvitationStatus @default(PENDING)
  volunteerRoles VolunteerRole[]
  expiresAt DateTime

  invitedById String
  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationId])
  @@index([token])
  @@index([email])
  @@index([organizationId])

}

model ServiceType {
  id String @id @default(uuid())
  name String
  color String

  events Event[]
  eventTemplates EventTemplate[]

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId, deletedAt])
}


model EventTemplate {
  id          String @id @default(uuid())
  name        String
  description String
  location    String

  dayOfWeek Int

  days EventTemplateDay[]

  rolesNeeded   VolunteerRole[]
  expiresInDays Int             @default(3)

  // Prefills the create-event form's smart scheduling switch.
  smartSchedulingEnabled Boolean @default(false)

  // Optional rehearsal, positioned relative to the template's first day the
  // same way EventTemplateDay.dayOffset is. Negative is the normal case — a
  // Thursday rehearsal for a Sunday service is -3 — and 0 means same day.
  // Times are wall clock "HH:mm" like EventTemplateDay, because a template has
  // no date to anchor an instant to. All three are set or all three are null.
  rehearsalDayOffset Int?
  rehearsalStartTime String?
  rehearsalEndTime   String?

  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([serviceTypeId])
}

model EventTemplateDay {
  id        String @id @default(uuid())
  dayOffset Int
  startTime String
  endTime   String

  templateId String
  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, dayOffset])
  @@index([templateId])
}

model Event {
  id String @id @default(uuid())
  name String 
  description String
  location String

  // Optional rehearsal block, stored as floating-UTC wall clock like EventDate.
  // Deliberately not EventDate rows: those are the event's service days, and
  // they drive conflict checks, the multi-day date range, and the email "when"
  // line. Display-only — a rehearsal never enters availability or blockout
  // checks, so nothing in lib/services/scheduling.ts reads these.
  rehearsalStart DateTime?
  rehearsalEnd   DateTime?

  rolesNeeded VolunteerRole[]

  // Smart scheduling — when enabled, declining this event's invite auto-invites
  // the next best available member for that role.
  smartSchedulingEnabled Boolean @default(false)

  // When the roster last became fully staffed: every role has someone who
  // accepted, and nobody is still deciding. Null whenever that isn't true.
  // Claimed atomically by syncEventNotifications, which is what makes the
  // "fully staffed" email go out once per fill-up instead of once per
  // reconcile.
  fullyStaffedAt DateTime?

  // How far the pre-event staffing check has got: 0 none yet, 1 the 3-day
  // check, 2 the 1-day check. Claimed by the hourly cron so each check runs
  // once, and reset to 0 when the event's dates change.
  lastCallStage Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments EventAssignment[]
  dates EventDate[]

  setlistSongs SetlistSong[]
  messages Message[]
  activityLogs ActivityLog[]


  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  serviceTypeId String
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([serviceTypeId])
  @@index([organizationId])
  notifications Notification[]
}

model EventAssignment {
  id String @id @default(uuid())

  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user User @relation("assignedUser", fields: [userId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy User? @relation("assignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role VolunteerRole
  status InvitationStatus @default(PENDING)

  // True when this assignment was created by smart scheduling (auto-refill).
  autoAssigned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@unique([eventId, userId])
  @@index([organizationId])
  @@index([eventId])
  @@index([userId])
  @@index([status])

}

model EventDate {
  id  String @id @default(uuid())
  startTime DateTime
  endTime DateTime

  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model BlockoutDate {
  id        String   @id @default(uuid())
  startDate DateTime
  endDate   DateTime

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, endDate])
  @@index([userId, organizationId])
}

model Message {
  id   String @id @default(uuid())
  body String

  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorId String
  author   User @relation("authoredMessages", fields: [authorId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([organizationId])
  @@index([authorId])
}

model ActivityLog {
  id   String       @id @default(uuid())
  type ActivityType

  // Snapshotted display strings, not FKs, so feed entries survive deletion of
  // the user/event/invitation they describe. actorName null = system activity.
  actorName  String?
  targetName String?
  detail     String?
  // The event's name at write time. eventId is SetNull, so this is also the only
  // durable "this activity was about an event" flag — read it, not eventId, when
  // deciding how to phrase a row.
  eventName  String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Only good for linking to a live event; null once the event is deleted.
  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
}

model Song {
  id String @id @default(uuid())
  title String
  artist String
  bpm Int
  timeSignature String
  defaultPitch Pitch
  defaultKeyQuality KeyQuality
  spotifyUrl String?
  youtubeUrl String?
  themes String[]

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  setlistSongs SetlistSong[]
  attachments SongAttachment[]
  keyEntries SongKeyEntry[]


  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, title, artist])
  @@index([organizationId, deletedAt])

}

model SetlistSong {
  id String @id @default(uuid())
  pitch Pitch
  keyQuality KeyQuality
  bpm Int
  timeSignature String
  position Int

  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  songId String
  song Song @relation(fields: [songId], references: [id])

  setlistSongAssignment SetlistSongAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, songId])
  @@index([eventId])
  @@index([songId])

}

model SongAttachment {
  id   String @id @default(uuid())
  name String
  url  String
  key  String @unique
  type String
  size Int

  songId String
  song   Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([songId])
}

model SetlistSongAssignment {
  id String @id @default(uuid())
  
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  setlistSongId String
  setlistSong SetlistSong @relation(fields: [setlistSongId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([setlistSongId, userId])
  @@index([userId])
}

/// A vocalist's record of the key they sing one song in. Scoped per
/// (user, organization) like BlockoutDate: a singer in two orgs keeps two
/// journals, and every cache tag here is already shaped user-X-thing-orgY.
///
/// Title and artist are snapshotted and `songId` is an optional SetNull link,
/// so an entry can outlive its song — or name one the library never had. When
/// the link is live the reader prefers the song's own title; the snapshot is
/// the durable fallback, not the display value.
model SongKeyEntry {
  id         String     @id @default(uuid())
  title      String
  artist     String
  pitch      Pitch
  keyQuality KeyQuality
  notes      String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Nullable by design. deleteOrganization hard-deletes Song rows before the
  // Organization row, so this goes null a step before the org cascade clears
  // the entry — neither teardown path needs a new step.
  songId String?
  song   Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Dedups library-linked entries. Postgres treats NULLs as distinct, so
  // freehand entries are not constrained by it — that is deliberate.
  @@unique([userId, songId])
  @@index([userId, organizationId])
  @@index([songId])
}

enum NotificationCategory {
  // Admin-facing: this event has roles nobody has taken.
  ROSTER_ATTENTION
  // Volunteer-facing: this event is waiting on your answer.
  AWAITING_RESPONSE
  // Admin-facing: every role is confirmed and nobody is still deciding.
  FULLY_STAFFED
}

/// A pointer at an event that needs someone's attention — not a record that
/// something happened. That is ActivityLog's job, and this is deliberately its
/// opposite in three ways:
///
///   - Nothing is snapshotted. ActivityLog copies names into strings so a row
///     survives the event being deleted; a notification is a claim about right
///     now, so `eventId` cascades and the names are joined live. A row can
///     never outlive, or disagree with, what it points at.
///   - One row per person per event per category, upserted rather than
///     appended. Five declines do not make five rows — they move `count` on the
///     one row that is already there.
///   - Rows are deleted once resolved, so the bell empties itself.
///
/// `count` is the only detail carried: open roles for ROSTER_ATTENTION, and
/// always 1 for AWAITING_RESPONSE and FULLY_STAFFED, where the row's existence
/// is the message. Everything else is a tap away in the app.
model Notification {
  id String @id @default(uuid())
  category NotificationCategory

  count Int @default(0)

  // Null once read. Re-set only when `count` rises — a roster getting better is
  // not news, and re-pinging on every accept is how a bell trains people to
  // ignore it.
  unreadAt DateTime?

  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The reconcile's upsert key, and what makes calling it twice harmless.
  @@unique([userId, eventId, category])
  @@index([userId, updatedAt])
  @@index([eventId])
  @@index([organizationId])
}

/// One installed copy of the phone app that can be pushed to, belonging to
/// whoever last signed in on it. Keyed by the token rather than the user, so a
/// phone that changes hands moves to the new account instead of ringing for
/// both. Deleted on sign-out, and whenever Expo reports the app is gone.
model PushToken {
  id    String @id @default(uuid())
  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
