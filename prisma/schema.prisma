generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum VolunteerRole {
  GUITARIST
  PIANIST
  AUX_KEYS
  DRUMMER
  LEAD_VOCALIST
  BGVS
  BASSIST
  SOUND_TECH
  STREAM_TECH
  PROJECTION_TECH
  USHER
  GREETER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum ActivityType {
  EVENT_CREATED
  EVENT_DELETED
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_DECLINED
  INVITE_CANCELED
  AUTO_INVITE_SENT
  MEMBER_REMOVED
  MEMBER_LEFT
  ROLE_CHANGED
  SMART_FILL_SKIPPED
  SMART_FILL_NO_CANDIDATES
  SMART_FILL_ALL_UNAVAILABLE
  SMART_FILL_FAILED
  SMART_SCHEDULING_ENABLED
  SMART_SCHEDULING_DISABLED
}

enum Pitch {
  C
  C_SHARP   @map("C#")
  D_FLAT    @map("Db")
  D
  D_SHARP   @map("D#")
  E_FLAT    @map("Eb")
  E
  F
  F_SHARP   @map("F#")
  G_FLAT    @map("Gb")
  G
  G_SHARP   @map("G#")
  A_FLAT    @map("Ab")
  A
  A_SHARP   @map("A#")
  B_FLAT    @map("Bb")
  B
}

enum KeyQuality {
  MAJOR
  MINOR
}



model User {
  id        String @id @default(uuid())
  clerkId   String @unique
  email     String @unique
  firstName String
  lastName  String
  phoneNumber String
  userImageUrl String?

  memberships Membership[]
  sentInvitations Invitation[] 
  eventsCreated Event[]
  
  assignedEvents EventAssignment[] @relation("assignedUser")
  createdAssignments EventAssignment[] @relation("assignedBy")

  authoredMessages Message[] @relation("authoredMessages")

  setlistSongAssignment SetlistSongAssignment[]

  blockoutDates BlockoutDate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  description String
  logoUrl     String?
  logoKey     String?

  // Stripe billing — mirror of entitlement feature lookup_keys from Stripe
  stripeCustomerId String?  @unique
  entitlements     String[] @default([])

  memberships Membership[]
  invitations Invitation[]
  serviceTypes ServiceType[]
  events Event[]
  eventTemplates EventTemplate[]
  eventAssignments EventAssignment[]
  songs Song[]
  messages Message[]
  blockoutDates BlockoutDate[]
  activityLogs ActivityLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Membership {
  id          String   @id @default(uuid())
  role OrgRole @default(MEMBER)
  volunteerRoles VolunteerRole[]

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, role])
}

model Invitation {
  id String @id @default(uuid())
  email String 
  token String @unique @default(uuid())
  status InvitationStatus @default(PENDING)
  volunteerRoles VolunteerRole[]
  expiresAt DateTime

  invitedById String
  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, organizationId])
  @@index([token])
  @@index([email])
  @@index([organizationId])

}

model ServiceType {
  id String @id @default(uuid())
  name String
  color String

  events Event[]
  eventTemplates EventTemplate[]

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId, deletedAt])
}


model EventTemplate {
  id          String @id @default(uuid())
  name        String
  description String
  location    String

  dayOfWeek Int

  days EventTemplateDay[]

  rolesNeeded   VolunteerRole[]
  expiresInDays Int             @default(3)

  // Prefills the create-event form's smart scheduling switch.
  smartSchedulingEnabled Boolean @default(false)

  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, organizationId])
  @@index([organizationId])
  @@index([serviceTypeId])
}

model EventTemplateDay {
  id        String @id @default(uuid())
  dayOffset Int
  startTime String
  endTime   String

  templateId String
  template   EventTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, dayOffset])
  @@index([templateId])
}

model Event {
  id String @id @default(uuid())
  name String 
  description String
  location String


  rolesNeeded VolunteerRole[]

  // Smart scheduling — when enabled, declining this event's invite auto-invites
  // the next best available member for that role.
  smartSchedulingEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments EventAssignment[]
  dates EventDate[]

  setlistSongs SetlistSong[]
  messages Message[]
  activityLogs ActivityLog[]


  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  serviceTypeId String
  serviceType ServiceType @relation(fields: [serviceTypeId], references: [id])

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([serviceTypeId])
  @@index([organizationId])
}

model EventAssignment {
  id String @id @default(uuid())

  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user User @relation("assignedUser", fields: [userId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy User? @relation("assignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role VolunteerRole
  status InvitationStatus @default(PENDING)

  // True when this assignment was created by smart scheduling (auto-refill).
  autoAssigned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@unique([eventId, userId])
  @@index([organizationId])
  @@index([eventId])
  @@index([userId])
  @@index([status])

}

model EventDate {
  id  String @id @default(uuid())
  startTime DateTime
  endTime DateTime

  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model BlockoutDate {
  id        String   @id @default(uuid())
  startDate DateTime
  endDate   DateTime

  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, endDate])
  @@index([userId, organizationId])
}

model Message {
  id   String @id @default(uuid())
  body String

  eventId String
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  authorId String
  author   User @relation("authoredMessages", fields: [authorId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([eventId, createdAt])
  @@index([organizationId])
  @@index([authorId])
}

model ActivityLog {
  id   String       @id @default(uuid())
  type ActivityType

  // Snapshotted display strings, not FKs, so feed entries survive deletion of
  // the user/event/invitation they describe. actorName null = system activity.
  actorName  String?
  targetName String?
  detail     String?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([eventId, createdAt])
}

model Song {
  id String @id @default(uuid())
  title String
  artist String
  bpm Int
  timeSignature String
  defaultPitch Pitch
  defaultKeyQuality KeyQuality
  spotifyUrl String?
  youtubeUrl String?
  themes String[]

  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  setlistSongs SetlistSong[]
  attachments SongAttachment[]


  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, title, artist])
  @@index([organizationId, deletedAt])

}

model SetlistSong {
  id String @id @default(uuid())
  pitch Pitch
  keyQuality KeyQuality
  bpm Int
  timeSignature String
  position Int

  eventId String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  songId String
  song Song @relation(fields: [songId], references: [id])

  setlistSongAssignment SetlistSongAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, songId])
  @@index([eventId])
  @@index([songId])

}

model SongAttachment {
  id   String @id @default(uuid())
  name String
  url  String
  key  String @unique
  type String
  size Int

  songId String
  song   Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([songId])
}

model SetlistSongAssignment {
  id String @id @default(uuid())
  
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  setlistSongId String
  setlistSong SetlistSong @relation(fields: [setlistSongId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([setlistSongId, userId])
  @@index([userId])
}